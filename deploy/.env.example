# ============================================================================
# 鎏金台 AURUM STAGE · 环境变量样例（deploy/.env.example）
# ----------------------------------------------------------------------------
# 用法：cp deploy/.env.example deploy/.env ，按机房实际情况改值。
# compose 里 api 服务用 env_file: .env 注入；
# 标注【API 读取】的键由 services/api/src/config.ts 直接解析并生效；
# 标注【部署层】的键由 compose / GPU 节点启动脚本 / 运维侧读取，
# 当前 API 版本尚未在进程内解析（默认内嵌 SQLite + 本地文件系统），
# 切换到 PG / MinIO 时按这里的契约注入即可。
# ============================================================================

# ---------------------------------------------------------------------------
# 数据库
# ---------------------------------------------------------------------------
# 【部署层】业务库连接串。留空或使用 file: 前缀 = 使用内嵌 SQLite（.data/aurum.db，默认）。
# 指向 postgresql:// 时由 compose 的 postgres:16 承接（此时 DATABASE_URL 生效）。
DATABASE_URL=postgresql://aurum:aurum_dev_pwd@postgres:5432/aurum

# 【部署层】postgres 容器初始化账号（compose 的 postgres 服务读取）
POSTGRES_USER=aurum
POSTGRES_PASSWORD=aurum_dev_pwd
POSTGRES_DB=aurum

# ---------------------------------------------------------------------------
# 队列 / 缓存
# ---------------------------------------------------------------------------
# 【部署层】Redis 连接串：调度限流计数、SSE/WS 事件广播、幂等键短缓存。
REDIS_URL=redis://redis:6379/0

# ---------------------------------------------------------------------------
# 对象存储（MinIO，S3 兼容）
# ---------------------------------------------------------------------------
# 【部署层】MinIO 服务地址（容器内用服务名 minio，宿主/VPN 侧用 <host>:9000）。
MINIO_ENDPOINT=minio:9000
# 【部署层】MinIO 控制台端口，浏览器打开 http://<host>:9001
MINIO_CONSOLE_PORT=9001
# 【部署层】访问密钥（compose 用它初始化 minio 容器，SDK 侧配对使用）
MINIO_ROOT_USER=aurum
MINIO_ROOT_PASSWORD=aurum_dev_minio_pwd
# 【部署层】桶名：素材/成片统一落这个桶，按 projects/<id>/... 组织前缀
MINIO_BUCKET=aurum
# 【部署层】内网自签证书时置 true（需把 CA 挂进容器信任链）
MINIO_USE_SSL=false

# ---------------------------------------------------------------------------
# 共享存储（NFS）：GPU 节点与中台之间的中间产物交换区
# ---------------------------------------------------------------------------
# 【部署层】中台容器内看到的 NFS 挂载点；GPU 节点用同一路径读到同一份中间产物。
NFS_ROOT=/nfs/aurum
# 【部署层】宿主机上的 NFS 挂载源（compose 用它做 bind mount，默认 ./nfs 便于单机试跑）。
NFS_HOST_ROOT=/mnt/nas/aurum

# ---------------------------------------------------------------------------
# 云端渲染通道（Muse Video API）
# ---------------------------------------------------------------------------
# 【API 读取】云端渲染网关地址，形如 https://api.muse.example
MUSE_API_BASE=https://api.muse.example
# 【API 读取】云端通道每秒请求上限，调度器据此限制 muse_api 并发（1-3 安全区间）
MUSE_QPS=2
# 【API 读取】模拟链路延迟区间（毫秒）。无真实密钥时用它跑通全流程。
MUSE_SIM_MIN_MS=2600
MUSE_SIM_MAX_MS=7800
# 【API 读取】模拟失败率 0-1，压测重试矩阵时调高。
MUSE_SIM_FAIL_RATE=0.05

# ---------------------------------------------------------------------------
# TTS Worker（IndexTTS-2，跑在 GPU 节点上，不进 compose）
# ---------------------------------------------------------------------------
# 【API 读取】TTS Worker 的 HTTP 地址。注意默认值 127.0.0.1:9001 与 MinIO 控制台
# 端口冲突，生产务必改成 GPU 节点内网地址。
TTS_WORKER_URL=http://10.0.0.21:9001
# 【API 读取】TTS 并发数，调度器按此控制同类型任务并行度（建议 = GPU 卡数 × 1）。
TTS_CONCURRENCY=4
# 【API 读取】TTS 模拟延迟（毫秒），COMFY_SIMULATE=true 时用于本地演示。
TTS_SIM_LATENCY_MS=420

# ---------------------------------------------------------------------------
# 本地渲染通道（ComfyUI · H3）
# ---------------------------------------------------------------------------
# 【API 读取】true = 本地渲染走模拟产物（无需 GPU 即可跑通全流程）；接真机后置 false。
COMFY_SIMULATE=true
# 【API 读取】单节点 H3 并发（显存 24G 建议 1，48G 可 2）
H3_CONCURRENCY=1
# 【API 读取】H3 任务最大尝试次数（OOM 会降级重试一次）
H3_MAX_ATTEMPT=2
# 【部署层】H3 单片段时长硬上限（秒），GPU 侧脚本与前端提示共用，业务常量默认 8
H3_MAX_DURATION_SEC=8

# ---------------------------------------------------------------------------
# 口型对齐（MuseTalk，跑在 GPU 节点上）
# ---------------------------------------------------------------------------
# 【API 读取】总开关：false = 全项目跳过 lipsync，直接使用原片。
LIPSYNC_ENABLED=true
# 【API 读取】触发策略：close_up_only（仅特写类机位）| all_talking（所有说话镜头）| off
LIPSYNC_TRIGGER=close_up_only

# ---------------------------------------------------------------------------
# 中台 ↔ GPU 节点
# ---------------------------------------------------------------------------
# 【部署层】GPU 节点回连中台的地址（节点侧 agent 用它发心跳/拉任务）。
CENTER_URL=http://aurum-api:8787
# 【API 读取】节点与中台的双向校验 token（节点请求头 x-agent-token）。生产必须改。
AGENT_TOKEN=change-me-aurum-agent-token

# ---------------------------------------------------------------------------
# 服务与调度
# ---------------------------------------------------------------------------
# 【API 读取】监听端口，compose 内固定 8787，与 nginx 的 /api 反代一致。
AURUM_PORT=8787
# 【API 读取】监听地址：容器内必须是 0.0.0.0，本机开发默认 127.0.0.1。
AURUM_HOST=0.0.0.0
# 【API 读取】数据目录（SQLite 库、本地对象存储、导出产物都在这里）。
AURUM_DATA_DIR=/data
# 【API 读取】前端构建产物目录，供中台兜底静态托管（生产由 nginx 承担）。
AURUM_WEB_DIST=/app/web/dist
# 【API 读取】调度器总开关。维护窗口置 false 可停止派发，任务留在 pending。
SCHEDULER_ENABLED=true
# 【API 读取】调度心跳间隔（毫秒）
SCHEDULER_TICK_MS=350
# 【API 读取】全局最大并行任务数
SCHEDULER_MAX_PARALLEL=4
# 【API 读取】候选数量默认值（TTS 3 选 1、视频多候选时按此值展开）
DEFAULT_CANDIDATES=3
# 【API 读取】单段成片硬上限（秒）。业务常量固定 300，此处仅供灰度/压测改写，生产勿动。
SEGMENT_CAP_SEC=300
# 【API 读取】日志级别：debug | info | warn | error
AURUM_LOG_LEVEL=info

# ---------------------------------------------------------------------------
# 合成（FFmpeg）
# ---------------------------------------------------------------------------
# 【API 读取】FFmpeg 可执行文件路径。留空 = 使用 ffmpeg-static 自带二进制；
# 生产建议挂载系统 ffmpeg 并指向 /usr/bin/ffmpeg。
FFMPEG_PATH=/usr/bin/ffmpeg
# 【API 读取】BGM 混音增益（dB），-18 为访谈类默认（人声不被压住）。
BGM_VOLUME_DB=-18


# ── 玄枢・AURUM · 云端视频与文本模型（v1.1 新增）───────────────────────────────
# 云端视频走 APIMart（Muse 通道）：POST {base}/videos/generations → GET {base}/tasks/{task_id}
MUSE_API_BASE=https://api.apimart.ai/v1
# APIMart 控制台创建的 Key；留空则镜头走「导播代理片」并在资产 meta 标注 simulate_reason
MUSE_API_KEY=
# 默认视频模型：muse-video-ext（约 10s / 720p / 自带声音）| MiniMax-H3-Max | MiniMax-H3 | seedance-2.0 | VEO3
MUSE_MODEL=muse-video-ext
MUSE_RESOLUTION=720p
MUSE_POLL_MS=3000
MUSE_TIMEOUT_MS=480000

# DeepSeek：默认文本后端（OpenAI 兼容）
DEEPSEEK_BASE=https://api.deepseek.com/v1
DEEPSEEK_API_KEY=

# 本地 ComfyUI（GPU 机器上跑的实例；探测后自动生成模板）
COMFYUI_URL=http://127.0.0.1:8188
COMFY_SIMULATE=true
